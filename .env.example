# Neon PostgreSQL pooled connection string
# Example: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Shared demo password used by /login
DEMO_PASSWORD="replace-with-strong-demo-password"

# Long random secret used to sign session cookie hashes
SESSION_SECRET="replace-with-very-long-random-secret"
